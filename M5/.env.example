# ---------------------------------------------------------------------------------------
# Plantilla de configuración. Copia este archivo a `.env` y rellena lo que necesites:
#
#     cp .env.example .env
#
# `.env` está en .gitignore y NO se sube nunca. Este `.env.example` sí se versiona, pero
# sólo con valores de ejemplo: aquí no va ninguna clave real.
#
# En el Space de Hugging Face no se usa este archivo: cada variable se pone en
# Settings -> Variables and secrets.
#   - las que son CLAVES van como *Secret*  (GROQ_API_KEY, WANDB_API_KEY)
#   - las demás como *Variable* (son públicas y quedan a la vista)
#
# TODAS son opcionales. Sin ninguna, el sistema arranca con los valores con los que se
# midieron los scorecards.
# ---------------------------------------------------------------------------------------


# =========================================================================================
# 1. SECRETOS  — nunca los pongas en el código ni los subas al repo
# =========================================================================================

# Redactor por API (plan gratuito: https://console.groq.com/keys).
# Si está presente, Groq pasa a ser el redactor y el cerebro del agente.
# Si NO está, el sistema no se cae: usa el Qwen2.5-0.5B + LoRA afinado en M1.
GROQ_API_KEY=

# Observabilidad en Weights & Biases (https://wandb.ai/authorize).
# Hace falta además AGRO_WANDB=1 para que se active.
WANDB_API_KEY=


# =========================================================================================
# 2. QUÉ MODELO REDACTA
# =========================================================================================

# auto | groq | fp16_gpu | fp32_cpu | bf16_cpu | int8_cpu | int4_gpu | fp32peft_cpu
#   auto      -> groq si hay clave; si no, fp16_gpu con GPU y fp32_cpu sin ella
#   fp16_gpu  -> el sistema tal como lo entregó M4 (es el que mejor puntúa de los propios)
#   bf16_cpu  -> la única variante comprimida que CUMPLE el contrato (mitad de memoria)
#   int8_cpu / int4_gpu -> medidas y RECHAZADAS; existen sólo para reproducir la tabla
AGRO_BACKEND=auto

# Modelo concreto de Groq. Si Groq lo retira, el código prueba los alternativos solo.
AGRO_GROQ_MODELO=openai/gpt-oss-120b

# Tope de tokens de la respuesta cuando redacta Groq. El de M2 (200) estaba dimensionado
# para un 0.5B y cortaba las respuestas a media frase. Si ves `truncadas` subiendo en el
# health check, súbelo.
AGRO_MAX_TOKENS=900


# =========================================================================================
# 3. CÓMO SE RESPONDE
# =========================================================================================

# Ruta del camino SIN foto: auto | react | determinista
#   react        -> el bucle ReAct de M3 (elige herramientas)
#   determinista -> diagnóstico diferencial + ficha, sin LLM planificador (para CPU lenta)
AGRO_RUTA=auto

# Quién elige las herramientas del bucle ReAct: auto | groq | local
#   local -> el Qwen2.5-1.5B de M3; en 2 vCPU cuesta decenas de segundos por consulta
AGRO_PLANIFICADOR=auto

# Pasajes que llegan al prompt y tope de contexto. Son los valores con los que se midió
# todo: subirlos mejora la respuesta pero deja de ser comparable con M3 y M4.
AGRO_K_FINAL=3
AGRO_MAX_CTX=3200

# Filtro de salida (hoja sana -> sin receta · sin diagnóstico -> sin receta · nunca dosis).
# 0 lo APAGA. Úsalo sólo para reproducir la ablación; en producción va encendido.
AGRO_FILTRO=1


# =========================================================================================
# 4. PUNTO DE OPERACIÓN DE LA VÁLVULA VISUAL
# =========================================================================================
# Los valores por defecto son los CALIBRADOS en M4 (percentil 5 del conjunto retenido), y
# son los que respaldan la frase "la tasa de falsas alarmas está declarada en ~5 %".
# Moverlos aquí es una decisión de OPERACIÓN, no una recalibración: el health check muestra
# el valor calibrado y el operativo, y avisa cuando difieren.
#
# Bajar AGRO_UMBRAL_PROTO hace que la válvula dispare MENOS y deje pasar fotos más lejanas
# a lo que el clasificador vio entrenando — útil con fotos de campo reales.

# AGRO_UMBRAL_PROTO=0.85      # calibrado: 0.9221
# AGRO_UMBRAL_P=0.2173        # confianza mínima de la clase top-1
# AGRO_UMBRAL_HOJA=0.50       # P(es una hoja de planta) mínima


# =========================================================================================
# 5. OBSERVABILIDAD
# =========================================================================================

# 1 activa W&B (además hace falta WANDB_API_KEY).
AGRO_WANDB=0
AGRO_WANDB_PROYECTO=agro-m5-produccion

# Dónde se escribe la línea JSON por petición.
# AGRO_LOGS=logs
# AGRO_LOG_JSONL=logs/peticiones.jsonl

# Etiqueta de versión que sale en el health check y en cada línea de log.
AGRO_VERSION=m5.0.0


# =========================================================================================
# 6. ZeroGPU / SERVIDOR
# =========================================================================================

# Segundos máximos de GPU por petición en ZeroGPU. Con Groq redactando, el Space ni
# siquiera pide GPU (lo dice el health check en zero_gpu.se_usa_en_cada_peticion).
AGRO_GPU_DURACION=120

# 1 crea un enlace público temporal de Gradio al correr en local (para una demo rápida).
AGRO_SHARE=0

# Puerto local.
# PORT=7860


# =========================================================================================
# 7. RUTAS  — sólo si mueves carpetas de sitio
# =========================================================================================

# AGRO_ARTEFACTOS=artefactos                      # índice + artefactos de visión
# AGRO_EJEMPLOS=ejemplos                          # imágenes de ejemplo de la app
# AGRO_LORA=mi-modelo-lora                        # adaptador LoRA de M1
# AGRO_ORIGEN=../modulos_anteriores/M4            # datos de M4: sólo para reconstruir y medir
